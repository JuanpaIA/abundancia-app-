{
  "expo": {
    "name": "Lumina",
    "slug": "lumina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/images/icon.png",
    "scheme": "lumina",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bgacademic.lumina",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSUserNotificationsUsageDescription": "Lumina te envía recordatorios de tu protocolo diario y alertas de portales energéticos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bgacademic.lumina",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "../../assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumina necesita acceso a tu galería para agregar imágenes a tu tablero de visión."
        }
      ],
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "../../assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d935bc6b-c5b5-4df0-b070-c42d8563294d"
      }
    },
    "privacyPolicyUrl": "https://bgacademic.com/privacy"
  }
}
