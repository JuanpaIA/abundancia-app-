{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@lumina/core": [
        "../../packages/core/src/index.ts"
      ],
      "@lumina/core/*": [
        "../../packages/core/src/*"
      ],
      "expo-blur": ["./node_modules/expo-blur"],
      "expo-blur/*": ["./node_modules/expo-blur/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "../../packages/core/src/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
